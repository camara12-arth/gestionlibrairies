{
  "name": "gestion-librairie",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src tests",
    "test": "jest --runInBand",
    "db:create": "createdb gestion_librairie",
    "db:schema": "psql -d gestion_librairie -f db/schema.sql",
    "db:seed": "psql -d gestion_librairie -f db/seed.sql",
    "db:init": "npm run db:schema && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
