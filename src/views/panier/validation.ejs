<%- include('../partials/header') %>
<h1>Valider la commande</h1>
<form method="post" action="/commande/valider" class="formulaire"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Prénom <input name="prenom" required value="<%= anciennesValeurs.prenom || '' %>"></label><label>Nom <input name="nom" required value="<%= anciennesValeurs.nom || '' %>"></label><label>E-mail <input type="email" name="email" value="<%= anciennesValeurs.email || '' %>"></label><label>Téléphone <input name="telephone" required></label><fieldset><legend>Mode de livraison</legend><label><input type="radio" name="mode_livraison" value="livraison" checked> Livraison à Bamako</label><label><input type="radio" name="mode_livraison" value="retrait"> Retrait en magasin</label></fieldset><label>Commune <input name="commune"></label><label>Quartier <input name="quartier"></label><label>Adresse précise <textarea name="adresse"></textarea></label><fieldset><legend>Paiement</legend><label><input type="radio" name="paiement" value="livraison" checked> Paiement à la livraison</label><label><input type="radio" name="paiement" value="retrait"> Paiement au retrait</label><label><input type="radio" name="paiement" value="orange"> Orange Money (simulation)</label><label><input type="radio" name="paiement" value="moov"> Moov Money (simulation)</label></fieldset><label>Téléphone mobile money <input name="telephone_paiement"></label><button class="bouton" type="submit">Confirmer la commande</button></form>
<%- include('../partials/footer') %>
