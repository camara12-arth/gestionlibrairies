<%- include('../partials/header') %>
<h1>Réinitialiser le mot de passe</h1>
<% if (erreurs.length) { %><div class="alert"><% erreurs.forEach(e => { %><p><%= e.msg %></p><% }) %></div><% } %>
<form method="post" action="/reinitialiser-mot-de-passe/<%= jeton %>" class="formulaire">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Nouveau mot de passe <input type="password" name="mot_de_passe" minlength="10" required></label>
  <label>Confirmation <input type="password" name="confirmation" minlength="10" required></label>
  <button class="bouton" type="submit">Changer le mot de passe</button>
</form>
<%- include('../partials/footer') %>
