<%- include('../partials/header') %><h1>Bons de commande</h1><form method="post" action="/admin/achats" class="formulaire"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><label>Fournisseur<select name="fournisseur_id"><%fournisseurs.forEach(f=>{%><option value="<%=f.id%>"><%=f.nom%></option><%})%></select></label><label>Livre<select name="livre_id"><%livres.forEach(l=>{%><option value="<%=l.id%>"><%=l.titre%></option><%})%></select></label><label>Quantité<input name="quantite" type="number" min="1" value="1"></label><label>Prix unitaire<input name="prix" type="number" min="0" value="0"></label><button class="bouton">Créer le bon</button></form><%achats.forEach(a=>{%><article class="carte-livre"><h2><%=a.reference%></h2><p><%=a.fournisseur_nom%> — <%=a.statut%> — <%=a.total%> FCFA</p><form method="post" action="/admin/achats/<%=a.id%>/recevoir"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button>Recevoir les marchandises</button></form></article><%})%><%- include('../partials/footer') %>
