<h2>Alertes de stock</h2><% alertes.forEach(l=>{%><p><a href="/admin/livres"><%=l.titre%></a> : <strong><%=l.quantite%></strong> / seuil <%=l.seuil_alerte%></p><%})%>
<%- include('../partials/footer') %>
