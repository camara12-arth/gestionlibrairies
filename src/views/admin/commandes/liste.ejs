<%- include('../../partials/header') %>
<h1>Gestion des commandes</h1><%commandes.forEach(c=>{%><article class="carte-livre"><h2><%=c.reference%></h2><p><%=c.statut%> — <%=c.total%> FCFA</p><form method="post" action="/admin/commandes/<%=c.id%>/statut"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="statut"><%['nouvelle','payee','preparee','livree','retiree','annulee'].forEach(s=>{%><option value="<%=s%>" <%=c.statut===s?'selected':''%>><%=s%></option><%})%></select><button>Changer</button></form></article><%})%>
<%- include('../../partials/footer') %>
