<%- include('../partials/header') %><h1>Utilisateurs</h1><%utilisateurs.forEach(u=>{%><article class="carte-livre"><h2><%=u.prenom%> <%=u.nom%></h2><p><%=u.email%></p><form method="post" action="/admin/utilisateurs/<%=u.id%>"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><select name="role"><%['admin','libraire','client'].forEach(r=>{%><option value="<%=r%>" <%=u.role===r?'selected':''%>><%=r%></option><%})%></select><select name="actif"><option value="1">Actif</option><option value="0" <%=!u.actif?'selected':''%>>Inactif</option></select><button>Modifier</button></form></article><%})%><%- include('../partials/footer') %>
